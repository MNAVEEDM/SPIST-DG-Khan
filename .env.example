# Copy this file to .env (same folder as package.json). Vite only exposes
# variables prefixed with VITE_ to the browser.
VITE_API_BASE_URL=http://localhost:5000

# The SchoolPortal app (spist-project) that the header "Login" menu points at.
# It pins port 5174 in development. Set this to the deployed URL in production —
# without it the menu links at localhost and dies outside your machine.
VITE_PORTAL_BASE_URL=http://localhost:5174
