# Copy this file to .env (same folder as package.json). Vite only exposes
# variables prefixed with VITE_ to the browser.

# From MongoDB Atlas: Database -> Connect -> Drivers -> copy the connection string,
# then replace <username>/<password> with your database user's credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/spist_admissions?retryWrites=true&w=majority

# Any long, random string - used to sign login sessions (JWTs).
JWT_SECRET=replace-this-with-a-long-random-string

PORT=5000

# The URL your Vite dev server runs on, so the API accepts requests from it.
CLIENT_ORIGIN=http://localhost:5173

# --- Confirmation email (sent after signup), optional ---------------------
# If EMAIL_USER / EMAIL_PASS are left blank, signup still works, it just
# skips sending the email.
EMAIL_USER=youraccount@gmail.com
EMAIL_PASS=your-16-character-app-password
EMAIL_FROM=youraccount@gmail.com

# --- Smart-SMS integration ------------------------------------------------
# The school code shown in the Smart-SMS topbar. The public course list is
# looked up with it, so the admission form offers the real courses.
SMS_SCHOOL_CODE=SCH-9CF169
