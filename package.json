{
  "name": "spist-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Official website frontend for South Punjab Institute of Science & Technology (SPIST), Dera Ghazi Khan",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:api": "npm --prefix server run dev",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "dev:api:local": "npm --prefix server run dev:localdb",
